Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /HGVD Topology1/Namespaces1
      Splitter Ratio: 0.58
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
    Background Color: 27; 33; 43
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Map
      Name: SLAM Map
      Enabled: true
      Value: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
      Draw Behind: true
      Alpha: 0.88
    - Class: rviz_default_plugins/RobotModel
      Name: TurtleBot3
      Enabled: true
      Value: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Collision Enabled: false
      Visual Enabled: true
    - Class: rviz_default_plugins/MarkerArray
      Name: HGVD Topology
      Enabled: true
      Value: true
      Topic:
        Value: /hgvd_explorer/topology
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Namespaces:
        gvd_radii: true
        samples: true
        centers: true
        edges: true
        astar_links: true
        viewpoints: true
    - Class: rviz_default_plugins/Marker
      Name: Active HGVD Goal
      Enabled: true
      Value: true
      Topic:
        Value: /hgvd_explorer/goal_marker
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Path
      Name: Nav2 Global Plan
      Enabled: true
      Value: true
      Topic:
        Value: /plan
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 39; 157; 91
      Line Style: Billboards
      Line Width: 0.035
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Target Frame: <Fixed Frame>
      Scale: 95
      X: 0
      Y: 0
      Angle: 0
Window Geometry:
  Width: 1220
  Height: 820
